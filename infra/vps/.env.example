# Copy to /opt/intercity/.env on the VPS and change every CHANGE_ME value.

API_DOMAIN=api.example.com
PUBLIC_WEB_URL=https://app.example.com

POSTGRES_DB=intercity
POSTGRES_USER=intercity
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

DATABASE_URL=postgresql://intercity:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/intercity
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_REFRESH_SECRET

NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://app.example.com,https://admin.example.com
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1500

OSRM_URL=http://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
YANDEX_GEOCODER_API_KEY=

BACKEND_PUBLIC_URL=https://api.example.com/api
PUBLIC_API_URL=https://api.example.com/api
KASSA24_API_URL=https://ecommerce.pult24.kz
KASSA24_LOGIN=
KASSA24_PASSWORD=
KASSA24_DEMO=false
FCM_SERVER_KEY=
GCS_BUCKET=

SEED_DEFAULT_ADMIN=false
SEED_ADMIN_PHONE=+70000000000
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
