		respond "INTERCITY API" 200
	}
}

intercity.89-207-255-27.sslip.io {
	encode gzip
	root * /srv/intercity/mobile
	handle_path /map-tiles/* {
		rewrite * /api/geo/tiles{path}
		reverse_proxy backend:3000
	}
	handle {
		header {
			Cache-Control "no-cache, no-store, max-age=0, must-revalidate"
			Pragma "no-cache"
			Expires "0"
		}
		try_files {path} /index.html
		file_server
	}
}

